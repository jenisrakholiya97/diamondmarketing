# Gigakelvin Diamonds - Environment Configuration Example

# Server & API Configuration
PORT=5000
VITE_API_URL="http://localhost:5000"

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diamond_marketing"
PGHOST="localhost"
PGPORT=5432
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="diamond_marketing"

# Company & Site Details
VITE_COMPANY_NAME="Gigakelvin Diamonds"
VITE_SITE_URL="https://gigakelvin.com"

# Direct Trade Contacts
VITE_CONTACT_EMAIL="trade@gigakelvin.com"
VITE_WHATSAPP_NUMBER="+919876543210"
VITE_WHATSAPP_DISPLAY="+91 98765 43210"

# CRM Lead Capture Endpoint
VITE_CRM_ENDPOINT="http://localhost:5000/api/quotes"

# Cloudflare Turnstile Site Key for Bot Protection (Optional)
VITE_TURNSTILE_SITE_KEY=""
